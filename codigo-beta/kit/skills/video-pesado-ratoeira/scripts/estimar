#!/usr/bin/env bash
# Mede o vídeo e estima quanto tempo um render vai levar AQUI, rodando só uma amostra com freio.
# Uso: bash estimar entrada.mp4 [opções de saída do ffmpeg]
#   bash estimar bruto.mp4 -c:v libx264 -preset veryfast -crf 23 -c:a aac
# Sem opções: só mostra duração, resolução, codecs e tamanho (ffprobe), sem render.
# A amostra roda 20 s do meio do vídeo pelo ffmpeg-leve e joga fora o resultado.
set -u
ent=${1:?uso: estimar entrada [opções de saída]}; shift
dir=$(cd "$(dirname "$0")" && pwd)

dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$ent")
tam=$(ffprobe -v error -show_entries format=size -of default=nw=1:nk=1 "$ent")
vid=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,r_frame_rate -of csv=p=0 "$ent")
aud=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$ent")
awk -v d="$dur" -v t="$tam" -v v="$vid" -v a="${aud:-nenhum}" 'BEGIN{
  printf "duração: %.0f s (%.1f min)\ntamanho: %.0f MB\nvídeo: %s\náudio: %s\n", d, d/60, t/1048576, v, a }'

[ $# -gt 0 ] || exit 0
amostra=20
awk "BEGIN{exit !($dur < $amostra*2)}" && amostra=$(awk "BEGIN{printf \"%d\", $dur/2}")
[ "$amostra" -ge 1 ] || { echo "vídeo curto demais pra estimar: roda direto"; exit 0; }
meio=$(awk "BEGIN{printf \"%.2f\", ($dur-$amostra)/2}")
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
ext=${ent##*.}
ini=$(date +%s.%N)
if ! bash "$dir/ffmpeg-leve" -loglevel error -ss "$meio" -t "$amostra" -i "$ent" "$@" -y "$tmp/amostra.$ext"; then
  echo "a amostra falhou: confere as opções do ffmpeg" >&2; exit 1
fi
fim=$(date +%s.%N)
awk -v d="$dur" -v a="$amostra" -v i="$ini" -v f="$fim" 'BEGIN{
  g=f-i; tot=d/a*g;
  printf "amostra: %d s de vídeo em %.1f s (%.2fx do tempo real)\n", a, g, a/g;
  printf "estimativa do render inteiro aqui: %.1f min (com a máquina como está agora)\n", tot/60 }'
