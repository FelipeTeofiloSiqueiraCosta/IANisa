OPT = os.environ.get("RATOEIRA_OPT", "/opt/ratoeira")
VERSOES = os.path.join(OPT, "versoes")
GUARDAR = 3  # versões antigas que ficam, além da que está no ar
LIB = os.environ.get("RATOEIRA_LIB", "/usr/local/lib/ratoeira")
PARTES = ("telas", "gateway", "agentes", "regras", "kit", "receita", "pacotes")
