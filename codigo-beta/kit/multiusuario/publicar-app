#!/usr/bin/env python3
"""Publica um app da Ratoeira (APPS.md). Roda como root, pela unit
ratoeira-publicar@<nome>.service, que o gateway liga (polkit) depois de gravar o pedido.
Plano: docs/2026-10-09-publicar-app-sem-sudo.md.

Lista fechada de ações, nesta ordem:
  1. lê o pedido do gateway e confere que a pasta é <área>/apps/<pasta> de uma área da config;
  2. valida o manifesto (ratoeira-app.json) contra um schema fixo; campo desconhecido é recusado;
  3. instala pacotes do sistema só se estiverem em /etc/ratoeira/pacotes-permitidos;
  4. cria o usuário app-<nome> (sistema, sem shell), a pasta de dados e o segredo de identidade;
  5. copia o código pra /opt/ratoeira/apps/<nome>/codigo (root, só leitura pro app);
  6. roda o "preparar" do manifesto COMO o app (venv, npm), escrevendo só em .../ambiente;
  7. escreve os scripts de iniciar e das rotinas, o drop-in da unit ratoeira-app@<nome> e os timers;
  8. liga e espera a rota de saúde; se falhar, volta a versão anterior;
  9. grava o registro em /etc/ratoeira/apps.d/<nome>.json, que o gateway lê.

O manifesto nunca escolhe usuário, pastas graváveis nem travas da unit. Não toca na config
principal do gateway e não mexe em app que não seja o do pedido.
"""
import grp, json, os, pwd, re, shutil, socket, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime, timezone

PEDIDOS = os.environ.get("RATOEIRA_PEDIDOS", "/var/lib/ratoeira/gateway-estado/publicar")
CONFIG = os.environ.get("RATOEIRA_CONFIG", "/etc/ratoeira/gateway.config.json")
GRUPO_GW = os.environ.get("RATOEIRA_GRUPO_GATEWAY", "ratoeira-gateway")
REGISTRO = os.environ.get("RATOEIRA_REGISTRO", "/etc/ratoeira/apps.d")
PERMITIDOS = os.environ.get("RATOEIRA_PACOTES", "/etc/ratoeira/pacotes-permitidos")
UNITS = "/etc/systemd/system"
PATH_APP = "/usr/local/bin:/usr/bin:/bin"

NOME_RE = re.compile(r"^[a-z][a-z0-9-]{1,30}$")
RESERVADOS = {"portal", "assets", "api", "ws"}
CAMPOS = {"nome", "titulo", "descricao", "porta", "iniciar", "preparar", "saude", "papeis", "publico",
          "chat", "pacotes", "memoria", "cpu", "rotinas", "chaves", "ambiente"}
# variáveis que a unit fixa; o "ambiente" do manifesto não pode trocar (EnvironmentFile ganha de Environment=)
FIXAS = {"PORTA", "DADOS", "AMBIENTE", "HOME", "RATOEIRA_APP", "RATOEIRA_BASE", "CREDENTIALS_DIRECTORY", "PYTHONUNBUFFERED"}
IGNORAR = shutil.ignore_patterns(".git", "node_modules", "__pycache__", ".venv", "venv", ".DS_Store", "*.pyc")

log_linhas = []


def log(texto):
    print(texto, flush=True)
    log_linhas.append(texto)


class Recusa(Exception):
    pass


def agora():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def gravar(caminho, texto, modo=0o644, dono=None):
    tmp = caminho + ".tmp"
    with open(tmp, "w") as f:
        f.write(texto)
    os.chmod(tmp, modo)
    if dono:
        os.chown(tmp, *dono)
    os.replace(tmp, caminho)


def rodar(cmd, timeout=600, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    saida = (r.stdout + r.stderr).strip()
    if saida:
        # barras de progresso de download (pip, playwright) só enchem o log
        linhas = [l for l in saida.splitlines() if "■" not in l and not re.search(r"\|\s+\|\s+\d+% of", l)]
        for linha in linhas[-40:]:
            log("  " + linha)
    return r.returncode


def texto(m, campo, maximo, obrigatorio=False, linha=True):
    v = m.get(campo)
    if v is None:
        if obrigatorio:
            raise Recusa(f'O manifesto precisa de "{campo}".')
        return None
    if not isinstance(v, str) or not v.strip() or len(v) > maximo or (linha and ("\n" in v or "\r" in v)):
        raise Recusa(f'"{campo}" inválido no manifesto (texto de uma linha, até {maximo} caracteres).')
    return v


def lista(m, campo, regex, maximo):
    v = m.get(campo, [])
    if not isinstance(v, list) or len(v) > maximo or any(not isinstance(x, str) or not re.fullmatch(regex, x) for x in v):
        raise Recusa(f'"{campo}" inválido no manifesto.')
    return v


def validar(m, nome):
    if not isinstance(m, dict):
        raise Recusa("O manifesto não é um objeto JSON.")
    extras = set(m) - CAMPOS
    if extras:
        raise Recusa("Campo desconhecido no manifesto: " + ", ".join(sorted(extras)) + ".")
    if m.get("nome") != nome:
        raise Recusa(f'O "nome" do manifesto precisa ser "{nome}".')
    porta = m.get("porta")
    if not isinstance(porta, int) or isinstance(porta, bool) or not 1024 <= porta <= 65535:
        raise Recusa('"porta" inválida no manifesto (número de 1024 a 65535).')
    r = {
        "nome": nome, "porta": porta,
        "titulo": texto(m, "titulo", 60, True), "descricao": texto(m, "descricao", 300) or "",
        "iniciar": texto(m, "iniciar", 500, True), "preparar": texto(m, "preparar", 1000),
        "saude": texto(m, "saude", 100) or "/saude",
        "papeis": lista(m, "papeis", r"[a-z][a-z0-9-]{0,20}", 10),
        "publico": lista(m, "publico", r"/[a-z0-9][a-z0-9_-]*/", 10),
        "pacotes": lista(m, "pacotes", r"[a-z0-9][a-z0-9.+-]{0,60}", 30),
        "chaves": lista(m, "chaves", r"[A-Z][A-Z0-9_]{0,60}", 30),
        "memoria": m.get("memoria", "512M"), "cpu": m.get("cpu", "50%"),
        "chat": m.get("chat"), "rotinas": [],
    }
    if not re.fullmatch(r"/[A-Za-z0-9/_.-]*", r["saude"]):
        raise Recusa('"saude" inválida no manifesto (um caminho, ex.: "/saude").')
    if not isinstance(r["memoria"], str) or not re.fullmatch(r"[1-9][0-9]{1,4}M|[1-8]G", r["memoria"]):
        raise Recusa('"memoria" inválida no manifesto (ex.: "512M" ou "2G", até 8G).')
    if not isinstance(r["cpu"], str) or not re.fullmatch(r"([1-9][0-9]?|[1-3][0-9]{2}|400)%", r["cpu"]):
        raise Recusa('"cpu" inválida no manifesto (ex.: "50%", até "400%").')
    if r["chat"] is not None and (not isinstance(r["chat"], dict) or len(json.dumps(r["chat"])) > 2000):
        raise Recusa('"chat" inválido no manifesto.')
    rotinas = m.get("rotinas", [])
    if not isinstance(rotinas, list) or len(rotinas) > 10:
        raise Recusa('"rotinas" inválido no manifesto.')
    for x in rotinas:
        if not isinstance(x, dict) or set(x) - {"nome", "comando", "quando", "intervalo"}:
            raise Recusa('Rotina inválida no manifesto (campos: nome, comando, quando ou intervalo).')
        rn = x.get("nome")
        if not isinstance(rn, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", rn):
            raise Recusa("Rotina com nome inválido no manifesto.")
        cmd = texto(x, "comando", 500, True)
        quando, intervalo = x.get("quando"), x.get("intervalo")
        if (quando is None) == (intervalo is None):
            raise Recusa(f'A rotina "{rn}" precisa de "quando" (ex.: "*-*-* 03:00") ou de "intervalo" (ex.: "30min"), um dos dois.')
        if quando is not None and (not isinstance(quando, str) or not re.fullmatch(r"[A-Za-z0-9 *:,./~-]{1,60}", quando)):
            raise Recusa(f'"quando" inválido na rotina "{rn}".')
        if intervalo is not None and (not isinstance(intervalo, str) or not re.fullmatch(r"[1-9][0-9]{0,3}(s|min|h|d)", intervalo)):
            raise Recusa(f'"intervalo" inválido na rotina "{rn}" (ex.: "30min", "6h").')
        r["rotinas"].append({"nome": rn, "comando": cmd, "quando": quando, "intervalo": intervalo})
    amb = m.get("ambiente", {})
    if not isinstance(amb, dict) or len(amb) > 30:
        raise Recusa('"ambiente" inválido no manifesto (objeto com até 30 variáveis).')
    for k, v in amb.items():
        if not re.fullmatch(r"[A-Z][A-Z0-9_]{0,60}", k) or k in FIXAS or k in r["chaves"]:
            raise Recusa(f'Variável "{k}" não pode ir no "ambiente" (nome em MAIÚSCULAS, fora das fixas e das chaves).')
        if not isinstance(v, str) or len(v) > 500 or re.search(r'[\n\r"\\]', v):
            raise Recusa(f'Valor de "{k}" inválido no "ambiente" (texto de uma linha, sem aspas nem barra invertida).')
    r["ambiente"] = amb
    if len({x["nome"] for x in r["rotinas"]}) != len(r["rotinas"]):
        raise Recusa("Duas rotinas com o mesmo nome no manifesto.")
    return r


def areas_da_config(cfg):
    areas = cfg.get("areas") or []
    if not areas and (cfg.get("portal") or {}).get("repoDir"):
        areas = [{"id": "principal", "caminho": cfg["portal"]["repoDir"]}]
    return {a["id"]: a["caminho"] for a in areas if isinstance(a, dict) and a.get("id") and a.get("caminho")}


def dividir_dados(dados, usuario, grupo):
    """A pasta de dados do app é dividida com o time da área: o agente de cada pessoa lê e muda o banco e os
    arquivos direto, sem tela nem ferramenta. Grupo da pasta = o da área (quem tem a área tem os dados dos apps
    dela), setgid pra herdar, e ACL padrão pro usuário do app e pro grupo: arquivo criado pelo agente (dono é a
    pessoa) segue legível e gravável pelo app, e o do app pelo time. O SQLite copia a permissão do banco pro
    -wal/-shm, então o banco precisa de escrita pro grupo também."""
    if grupo == "root":
        log("dados do app: a área não tem grupo próprio, ficam só do app")
        return
    subprocess.run(["chgrp", "-R", grupo, dados], check=True)
    subprocess.run(["find", dados, "-type", "d", "-exec", "chmod", "g+s", "{}", "+"], check=True)
    acl = f"u:{usuario}:rwX,g:{grupo}:rwX,m::rwx"
    subprocess.run(["setfacl", "-R", "-m", acl, "-d", "-m", acl, dados], check=True)
    # o -d só vale pra pasta; pros arquivos que já existem, a regra de acesso
    subprocess.run(["setfacl", "-R", "-m", acl, dados], check=True)
    subprocess.run(["chmod", "-R", "g+rwX,o-rwx", dados], check=True)
    log(f"dados do app divididos com o grupo {grupo}")


def pacote_instalado(p):
    return subprocess.run(["dpkg", "-s", p], capture_output=True).returncode == 0


def porta_ocupada(porta):
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(("127.0.0.1", porta)) == 0


def ativo(unit):
    return subprocess.run(["systemctl", "is-active", "-q", unit]).returncode == 0


def escrever_units(nome, m, base):
    """Scripts de iniciar e das rotinas (root, 755) + drop-in da unit + timers. O texto do manifesto
    só entra em script que roda como o app; a unit nunca recebe texto do manifesto."""
    # configuração sem segredo (o "ambiente" do manifesto); os segredos ficam nas chaves
    gravar(f"{base}/ambiente.env", "# gerado pelo publicar-app a partir do manifesto; não editar\n" + "".join(f'{k}="{v}"\n' for k, v in m.get("ambiente", {}).items()))
    gravar(f"{base}/iniciar", f"#!/bin/sh\n# gerado pelo publicar-app a partir do manifesto; não editar\ncd {base}/codigo || exit 1\n{m['iniciar']}\n", 0o755)
    dropin = f"{UNITS}/ratoeira-app@{nome}.service.d"
    os.makedirs(dropin, exist_ok=True)
    gravar(f"{dropin}/app.conf", f"# gerado pelo publicar-app a partir do manifesto\n[Service]\nMemoryMax={m['memoria']}\nCPUQuota={m['cpu']}\nEnvironment=PORTA={m['porta']}\n")
    # rotinas: um script, um service e um timer por rotina. "_" separa app e rotina (nome de app não tem "_"),
    # e só se apaga rotina que estava no manifesto anterior deste app e saiu do novo
    prefixo = f"ratoeira-app-{nome}_"
    querem = {x["nome"] for x in m["rotinas"]}
    try:
        with open(f"{base}/manifesto.json") as f:
            antes = {x["nome"] for x in json.load(f).get("rotinas", [])}
    except (OSError, ValueError):
        antes = set()
    for rn in antes - querem:
        subprocess.run(["systemctl", "disable", "--now", f"{prefixo}{rn}.timer"], capture_output=True)
        for arq in (f"{UNITS}/{prefixo}{rn}.timer", f"{UNITS}/{prefixo}{rn}.service", f"{base}/rotina-{rn}"):
            if os.path.exists(arq):
                os.remove(arq)
    for x in m["rotinas"]:
        rn = x["nome"]
        gravar(f"{base}/rotina-{rn}", f"#!/bin/sh\n# gerado pelo publicar-app; não editar\ncd {base}/codigo || exit 1\n{x['comando']}\n", 0o755)
        gravar(f"{UNITS}/{prefixo}{rn}.service", f"""# gerado pelo publicar-app ({nome}, rotina {rn})
[Unit]
Description=Ratoeira, app {nome}: rotina {rn}

[Service]
Type=oneshot
User=app-{nome}
Group=app-{nome}
WorkingDirectory={base}/codigo
Environment=RATOEIRA_APP={nome} RATOEIRA_BASE=/{nome} DADOS=/var/lib/ratoeira/apps/{nome} HOME=/var/lib/ratoeira/apps/{nome} AMBIENTE={base}/ambiente PORTA={m['porta']} PYTHONUNBUFFERED=1
EnvironmentFile=-{base}/ambiente.env
EnvironmentFile=-/etc/ratoeira/apps/{nome}/chaves.env
LoadCredential=ratoeira-segredo:/etc/ratoeira/apps/{nome}/ratoeira.segredo
ExecStart={base}/rotina-{rn}
TimeoutStartSec=30min
MemoryMax={m['memoria']}
CPUQuota={m['cpu']}
UMask=0007
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ratoeira/apps/{nome}
PrivateTmp=true
NoNewPrivileges=true
""")
        quando = f"OnCalendar={x['quando']}\nPersistent=true" if x["quando"] else f"OnBootSec=30s\nOnUnitInactiveSec={x['intervalo']}\nAccuracySec=1s"
        gravar(f"{UNITS}/{prefixo}{rn}.timer", f"""# gerado pelo publicar-app ({nome}, rotina {rn})
[Unit]
Description=Ratoeira, app {nome}: quando rodar a rotina {rn}

[Timer]
{quando}

[Install]
WantedBy=timers.target
""")
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    for x in m["rotinas"]:
        subprocess.run(["systemctl", "enable", "-q", "--now", f"{prefixo}{x['nome']}.timer"], check=True)


def saudavel(m, segundos=60):
    url = f"http://127.0.0.1:{m['porta']}{m['saude']}"
    fim = time.time() + segundos
    while time.time() < fim:
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                return r.status < 500
        except urllib.error.HTTPError as e:
            if e.code < 500:
                return True
        except Exception:
            pass
        time.sleep(1)
    return False


def juntar_chaves(destino, usuario, nome, declaradas):
    """definir_chaves_app (#353 da FeedMe, 28/10/2026): junta no chaves.env do app as chaves que quem pediu deixou em
    ~<usuario>/.config/ratoeira/chaves-apps/<app>.env (NOME=valor por linha, arquivo comum, dele, modo 600), e apaga
    a origem. Só entram os nomes do campo "chaves" do manifesto; troca os que já existem e mantém os outros.
    Valor nunca vai pro log nem pro resultado: só os nomes. Mesmo cuidado da receita chaves-app."""
    if not isinstance(usuario, str) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", usuario):
        raise Recusa("Pedido de chaves sem usuário válido.")
    try:
        pw = pwd.getpwnam(usuario)
    except KeyError:
        raise Recusa(f"O usuário {usuario} não existe.")
    origem = os.path.join(pw.pw_dir, ".config", "ratoeira", "chaves-apps", nome + ".env")
    try:
        fd = os.open(origem, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise Recusa(f"Não achei as chaves em {origem} (arquivo comum, não atalho). Grave lá, NOME=valor por linha, modo 600, e chame de novo.")
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if st.st_uid != pw.pw_uid:
            raise Recusa(f"{origem} não é de {usuario}.")
        if st.st_mode & 0o077:
            raise Recusa(f"{origem} precisa ter modo 600 (só o dono lê).")
        linhas = [l.rstrip("\n") for l in f]
    vindas = {}
    for l in linhas:
        mt = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.+)", l.strip())
        if mt:
            vindas[mt.group(1)] = mt.group(2)
    novas = [k for k in vindas if k in declaradas]
    ignoradas = [k for k in vindas if k not in declaradas]
    if not novas:
        raise Recusa("Nenhuma das chaves do arquivo está no campo \"chaves\" do manifesto"
                     + (f" (veio: {', '.join(ignoradas)})" if ignoradas else "") + ". Nada foi gravado.")
    with open(destino) as f:
        atuais = [l.rstrip("\n") for l in f]
    manter = [l for l in atuais if l.split("=", 1)[0].strip() not in novas]
    gravar(destino, "\n".join(manter + [f"{k}={vindas[k]}" for k in novas]) + "\n", 0o600, (0, 0))
    try:
        subprocess.run(["shred", "-u", origem], capture_output=True, timeout=30)
    finally:
        if os.path.exists(origem):
            os.remove(origem)
    log(f"chaves gravadas: {', '.join(novas)}" + (f"; fora do manifesto, ignoradas: {', '.join(ignoradas)}" if ignoradas else "") + " (origem apagada)")
    return novas, ignoradas


def publicar(nome):
    if not NOME_RE.fullmatch(nome) or nome in RESERVADOS:
        raise Recusa(f"Nome de app inválido: {nome}")
    with open(f"{PEDIDOS}/{nome}.json") as f:
        pedido = json.load(f)
    if pedido.get("nome") != nome:
        raise Recusa("O pedido não bate com o nome da unit.")
    por = str(pedido.get("por", ""))[:200]
    with open(CONFIG) as f:
        cfg = json.load(f)
    principais = {a.get("prefix"): a.get("port") for a in cfg.get("apps") or []}
    if f"/{nome}" in principais:
        raise Recusa(f"/{nome} está na config principal do gateway (publicado à mão). Tire de lá antes de publicar por aqui.")

    areas = areas_da_config(cfg)
    raiz = areas.get(pedido.get("area"))
    if not raiz:
        raise Recusa("Área desconhecida no pedido.")
    pasta = os.path.realpath(str(pedido.get("pasta", "")))
    if os.path.dirname(pasta) != os.path.join(os.path.realpath(raiz), "apps"):
        raise Recusa("A pasta do app precisa ficar em <área>/apps/<pasta>.")
    try:
        with open(f"{pasta}/ratoeira-app.json") as f:
            m = validar(json.load(f), nome)
    except (OSError, ValueError) as e:
        raise Recusa(f"Não consegui ler o manifesto: {e}")
    log(f"manifesto ok: {m['titulo']} ({pasta})")

    # porta: nem de outro app nem de outro programa da máquina
    outros = [p for pre, p in principais.items()]
    if os.path.isdir(REGISTRO):
        for arq in os.listdir(REGISTRO):
            if arq.endswith(".json") and arq != f"{nome}.json":
                try:
                    with open(f"{REGISTRO}/{arq}") as f:
                        outros.append(json.load(f).get("port"))
                except (OSError, ValueError):
                    pass
    if m["porta"] in outros:
        raise Recusa(f"A porta {m['porta']} já é de outro app. Escolha outra no manifesto.")
    unit = f"ratoeira-app@{nome}.service"
    if porta_ocupada(m["porta"]) and not ativo(unit):
        raise Recusa(f"A porta {m['porta']} já está em uso nesta máquina. Escolha outra no manifesto.")

    # pacotes do sistema: só os liberados pelo admin
    faltam = [p for p in m["pacotes"] if not pacote_instalado(p)]
    if faltam:
        try:
            with open(PERMITIDOS) as f:
                ok = {l.strip() for l in f if l.strip() and not l.startswith("#")}
        except OSError:
            ok = set()
        barrados = [p for p in faltam if p not in ok]
        if barrados:
            raise Recusa("Pacote fora da lista liberada (" + PERMITIDOS + "): " + ", ".join(barrados) + ". Peça pro admin liberar.")
        log("instalando: " + " ".join(faltam))
        if rodar(["apt-get", "install", "-y", "-q", *faltam], timeout=900, env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"}) != 0:
            raise Recusa("Falhou instalar os pacotes do sistema.")

    usuario = f"app-{nome}"
    try:
        pw = pwd.getpwnam(usuario)
        if pw.pw_uid >= 1000:
            raise Recusa(f"{usuario} existe e não é usuário de sistema. Recusado.")
    except KeyError:
        subprocess.run(["useradd", "--system", "--home-dir", f"/var/lib/ratoeira/apps/{nome}", "--no-create-home",
                        "--shell", "/usr/sbin/nologin", usuario], check=True)
        pw = pwd.getpwnam(usuario)
        log(f"usuário {usuario} criado")
    gw = grp.getgrnam(GRUPO_GW).gr_gid
    base, dados, segredos = f"/opt/ratoeira/apps/{nome}", f"/var/lib/ratoeira/apps/{nome}", f"/etc/ratoeira/apps/{nome}"
    for d, dono, modo in [("/opt/ratoeira/apps", (0, 0), 0o755), (base, (0, 0), 0o755), (f"{base}/ambiente", (pw.pw_uid, pw.pw_gid), 0o755),
                          ("/var/lib/ratoeira/apps", (0, 0), 0o755), (dados, (pw.pw_uid, pw.pw_gid), 0o2770),
                          ("/etc/ratoeira/apps", (0, 0), 0o755), (segredos, (0, gw), 0o750), (REGISTRO, (0, gw), 0o750)]:
        os.makedirs(d, exist_ok=True)
        os.chown(d, *dono)
        os.chmod(d, modo)
    dividir_dados(dados, usuario, grp.getgrgid(os.stat(raiz).st_gid).gr_name)
    if not os.path.exists(f"{segredos}/ratoeira.segredo"):
        import base64
        gravar(f"{segredos}/ratoeira.segredo", base64.b64encode(os.urandom(32)).decode().rstrip("="), 0o640, (0, gw))
        log("segredo de identidade criado")
    chaves = f"{segredos}/chaves.env"
    if not os.path.exists(chaves):
        gravar(chaves, "# chaves do app (NOME=valor), uma por linha\n", 0o600, (0, 0))
    novas, ignoradas = juntar_chaves(chaves, pedido.get("chaves_de"), nome, m["chaves"]) if pedido.get("chaves_de") else ([], [])
    with open(chaves) as f:
        definidas = {l.split("=", 1)[0].strip() for l in f if "=" in l and not l.startswith("#")}
    faltam_chaves = [c for c in m["chaves"] if c not in definidas]

    # código novo ao lado do que está no ar
    novo = f"{base}/codigo.novo"
    shutil.rmtree(novo, ignore_errors=True)
    shutil.copytree(pasta, novo, ignore=IGNORAR, symlinks=True)
    commit = subprocess.run(["git", "-c", "safe.directory=*", "-C", pasta, "log", "-1", "--format=%h", "--", "."], capture_output=True, text=True).stdout.strip()
    sujo = subprocess.run(["git", "-c", "safe.directory=*", "-C", pasta, "status", "--porcelain", "--", "."], capture_output=True, text=True).stdout.strip()
    versao = f"{commit or 'sem-git'}{' +mudanças sem commit' if sujo else ''} {agora()} {por}"
    gravar(f"{novo}/.versao", versao + "\n")
    # a cópia não herda nada da área: sem ACL (a da área dá escrita pro time) e sem setgid
    subprocess.run(["setfacl", "-R", "-b", "-k", novo], check=True)
    subprocess.run(["chown", "-R", "root:root", novo], check=True)
    subprocess.run(["chmod", "-R", "u+rwX,go+rX,go-w,g-s", novo], check=True)
    log(f"código copiado ({versao})")

    if m["preparar"]:
        log("preparando (como " + usuario + ")")
        env = {"PATH": PATH_APP, "HOME": dados, "AMBIENTE": f"{base}/ambiente", "DADOS": dados, "RATOEIRA_APP": nome, "LANG": "C.UTF-8"}
        if rodar([shutil.which("runuser") or "/usr/sbin/runuser", "-u", usuario, "--", "sh", "-c", m["preparar"]], timeout=1500, cwd=novo, env=env) != 0:
            shutil.rmtree(novo, ignore_errors=True)
            raise Recusa('O "preparar" do manifesto falhou (log acima). Nada mudou no que está no ar.')

    # troca: o que estava no ar vira codigo.anterior
    atual, anterior = f"{base}/codigo", f"{base}/codigo.anterior"
    manifesto_ativo = f"{base}/manifesto.json"
    m_anterior = None
    if os.path.isdir(atual):
        shutil.rmtree(anterior, ignore_errors=True)
        os.rename(atual, anterior)
        try:
            with open(manifesto_ativo) as f:
                m_anterior = json.load(f)
        except (OSError, ValueError):
            pass
    os.rename(novo, atual)

    escrever_units(nome, m, base)
    subprocess.run(["systemctl", "enable", "-q", unit], check=True)
    subprocess.run(["systemctl", "restart", unit])
    if not saudavel(m):
        log(f"o app não respondeu em {m['saude']} na porta {m['porta']}; últimas linhas do log:")
        rodar(["journalctl", "-u", unit, "-n", "30", "--no-pager", "-o", "cat"])
        if m_anterior and os.path.isdir(anterior):
            shutil.rmtree(atual + ".falhou", ignore_errors=True)
            os.rename(atual, atual + ".falhou")
            os.rename(anterior, atual)
            escrever_units(nome, m_anterior, base)
            subprocess.run(["systemctl", "restart", unit])
            raise Recusa("A versão nova não subiu. Voltei a anterior, que segue no ar (o código que falhou ficou em codigo.falhou).")
        subprocess.run(["systemctl", "disable", "--now", unit], capture_output=True)
        raise Recusa("O app não subiu (log acima). Ele não foi pro portal.")
    gravar(manifesto_ativo, json.dumps(m, ensure_ascii=False, indent=1) + "\n")

    reg_arq = f"{REGISTRO}/{nome}.json"
    dono = por
    try:
        with open(reg_arq) as f:
            dono = json.load(f).get("dono") or por
    except (OSError, ValueError):
        pass
    registro = {"prefix": f"/{nome}", "port": m["porta"], "name": m["titulo"], "description": m["descricao"],
                "papeis": m["papeis"], "public": m["publico"], "segredo": f"{segredos}/ratoeira.segredo",
                "dono": dono, "publicadoPor": por, "versao": versao, "fonte": pasta, "dados": dados}
    if m["chat"]:
        registro["chat"] = dict(m["chat"])
        # chat.agente: a pasta do app com o AGENTS.md pro agente. Vai pro registro como caminho da cópia publicada
        # (legível por todo mundo), e a Ratoeira manda o agente de quem conversa ler.
        ag = m["chat"].get("agente")
        if isinstance(ag, str) and re.fullmatch(r"[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*/?", ag) and ".." not in ag.split("/") \
                and os.path.isfile(f"{base}/codigo/{ag.rstrip('/')}/AGENTS.md"):
            registro["chat"]["pastaAgente"] = f"{base}/codigo/{ag.rstrip('/')}"
    gravar(reg_arq, json.dumps(registro, ensure_ascii=False, indent=1) + "\n", 0o640, (0, gw))
    log(f"no ar: /{nome}/ (registro em {reg_arq})")
    # o texto fixo dos agentes lista os apps publicados (onde está o código e os dados): atualiza com este
    instrucoes = "/usr/local/lib/ratoeira/ratoeira-instrucoes"
    if os.path.exists(instrucoes) and rodar([instrucoes], timeout=60) != 0:
        log("aviso: não atualizei a lista de apps no texto dos agentes")
    r = {"versao": versao, "faltamChaves": faltam_chaves}
    if pedido.get("chaves_de"):
        r.update(chavesNovas=novas, chavesIgnoradas=ignoradas)
    return r


def main():
    nome = sys.argv[1] if len(sys.argv) > 1 else ""
    resultado = {"nome": nome, "em": agora()}
    codigo = 0
    try:
        resultado.update(ok=True, **publicar(nome))
    except Recusa as e:
        log("RECUSADO: " + str(e))
        resultado.update(ok=False, erro=str(e))
        codigo = 1
    except Exception as e:  # erro inesperado: vai pro log e pra tela, sem esconder
        log(f"ERRO: {type(e).__name__}: {e}")
        resultado.update(ok=False, erro=f"Erro inesperado ao publicar ({type(e).__name__}). Na VPS: journalctl -u ratoeira-publicar@{nome}")
        codigo = 1
    resultado["log"] = log_linhas[-80:]
    if NOME_RE.fullmatch(nome) and os.path.isdir(PEDIDOS):
        gravar(f"{PEDIDOS}/{nome}.resultado.json", json.dumps(resultado, ensure_ascii=False, indent=1) + "\n", 0o644)
        try:
            os.remove(f"{PEDIDOS}/{nome}.json")
        except OSError:
            pass
    sys.exit(codigo)


if __name__ == "__main__":
    main()
