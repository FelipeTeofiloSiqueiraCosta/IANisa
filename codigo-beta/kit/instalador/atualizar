CONHECIDOS = os.environ.get("RATOEIRA_FONTE_CONHECIDOS", "/etc/ratoeira/fonte.known_hosts")
CHAVE_PLATAFORMA = os.environ.get("RATOEIRA_PLATAFORMA_CHAVE", "/etc/ratoeira/plataforma.chave")
