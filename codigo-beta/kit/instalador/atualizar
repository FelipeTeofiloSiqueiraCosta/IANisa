ORDEM = ("kit", "regras", "agentes", "gateway")  # gateway por último: é o único que reinicia algo na hora
VERSAO = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)$")
GUARDAR_BACKUPS = 5

